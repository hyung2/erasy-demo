// 이레이지(Erasy) STEP02 MVP — Prisma 스키마
// SSOT: 03-step02-mvp/db-schema-draft-T1.4.md (Vault) + G0 컴포넌트 계약
// 스택 락(T1.2): PostgreSQL + Prisma. enum·String[]는 PostgreSQL 네이티브 사용.
// 자격증명 미저장 원칙: **사용자가 관리하는 외부 서비스(구글·네이버·넷플릭스…)의 비밀번호·토큰을
// 저장하지 않는다.** Account 모델에 password 계열 컬럼이 없는 이유이며, 점수 신호는 비번값 없이 표현한다.
// User.passwordHash는 이 원칙의 대상이 아니다 — 본 서비스 자체 로그인 수단이며 원문이 아닌 scrypt 해시만 보관.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DB 호스팅 = Neon(serverless). 서버리스는 pooled 연결로 런타임, direct 연결로 migrate.
  //  - Vercel-Neon 통합은 POSTGRES_PRISMA_URL(pooled)·POSTGRES_URL_NON_POOLING(direct)을 자동 주입.
  //    Vercel env에서 DATABASE_URL=POSTGRES_PRISMA_URL, DIRECT_URL=POSTGRES_URL_NON_POOLING로 별칭 등록.
  //  - 로컬 .env는 단일 direct 연결 문자열을 DATABASE_URL·DIRECT_URL 둘 다에 동일 지정 가능.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums (도메인 SSOT = G0 계약) ──
enum Provider {
  google
  naver
  kakao
  apple
  manual // dummy-data의 email-password → manual
}

enum Category {
  social
  overseas
  domestic
  // 분류를 알 수 없음. 소셜 연결목록처럼 서비스명만 오는 입력에서, 카탈로그에 없는 곳을
  // 임의로 domestic/overseas로 찍지 않기 위한 값이다(추측을 사실처럼 저장하지 않는다).
  unknown
}

enum RiskTag {
  breach
  reuse
  dormant
  no2fa
  subscription
}

enum ActionType {
  password_change
  delete
  revoke
  logout_sessions
  unsubscribe
}

// O6 확정: 데모 2상태(queued→done)에서 4상태로 확장(실행 실패·진행 추적)
enum CleanupStatus {
  queued
  in_progress
  done
  failed
}

enum AlertType {
  breach
  score_drop
  recleanup
}

enum BreachSeverity {
  high
  mid
  low
}

// T1.1 스파이크: 연결앱 실수집 불가 → F2 시드+직접입력 하이브리드 확정
enum AccountSource {
  seed // 페르소나 데모 시드
  user_input // 사용자 직접 입력
  oauth_linked // 로그인 provider 본인 계정만(연결앱 조회 아님)
  mail_scan // 메일함 스캔으로 발견(T5.6). 활동일은 수신일 기준 "추정치" — 실 로그인일 아님
  // 소셜 연결서비스 목록을 사용자가 가져옴. 플랫폼이 API를 열지 않아 사용자 주도 붙여넣기다.
  // 메일 스캔과 달리 **추론이 아니라 플랫폼이 준 사실**이라, 카탈로그에 없어도 계정으로 인정한다.
  social_link
}

// ── Models ──
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // 자체 가입(이메일+비밀번호) 사용자만 채워진다. 소셜 로그인 사용자는 null.
  // 형식은 lib/password.ts의 `scrypt$N$r$p$salt$hash`. 원문 비밀번호는 저장하지 않는다.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 유출 대조를 실제로 수행한 시각. null = 한 번도 대조하지 않음.
  //
  // 이 필드가 없으면 "대조했는데 깨끗함"과 "대조한 적 없음"을 구분할 수 없고,
  // 그 둘이 같아지는 순간 E축은 계정만 있으면 만점을 준다(2026-08-21 이전 상태).
  // Breach 레코드의 유무로는 대신할 수 없다 — 유출이 없는 사용자는 어느 쪽이든 0건이다.
  breachCheckedAt DateTime?

  accounts        Account[]
  cleanupRequests CleanupRequest[]
  breaches        Breach[]
  alerts          Alert[]
  scoreSnapshots  ScoreSnapshot[]
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  provider Provider
  category Category
  source   AccountSource @default(user_input) // 출처 정직 표기(over-claim 방지)

  // ── 서비스 정규화 (2026-08-21) ──
  //   name은 자유 문자열이라 같은 서비스가 표기별로 흩어진다(실측: Clerk/clerk.com 등 4쌍).
  //   그래서 "몇 명이 어떤 서비스를 쓰는가"를 질의할 수 없고, 유출이 확인돼도 같은 서비스를
  //   쓰는 다른 사용자에게 알릴 방법이 없다. Service로 신원을 모은다.
  //
  //   name은 지우지 않는다. rawName에 수집 원문을 보존하고 화면이 전부
  //   `service.displayName ?? rawName`으로 옮겨간 뒤에 정리한다.
  rawName   String? // 수집 원문(확장·스캔이 준 그대로). 백필 후 필수화 검토
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // ── 점수 산식 입력 신호 (전부 비번값 없이 표현) ──
  lastUsedAt       DateTime? // null=미상. 휴면(3년+) 판정 원천
  twoFactorEnabled Boolean   @default(false) // no2fa 신호 = !twoFactorEnabled
  passwordReused   Boolean   @default(false) // 재사용 신호(불리언만, 비번값 저장 금지)
  // 사용자가 위 두 신호를 **실제로 신고한 시각**. H축 분모 편입의 근거는 값이 아니라 이 행위다.
  //   전에는 `passwordReused || twoFactorEnabled`로 신고 여부를 짐작했다. 그러면 "고유 비번을
  //   쓰고 2FA는 안 켰다"는 정직한 신고가 (false,false)가 되어 미신고와 구분되지 않고 통째로
  //   사라진다. 비밀번호 위생이 좋은 사용자일수록 위생축을 못 켜는 역전이 생긴다(2026-08-26).
  //   기록해야 할 것은 답의 내용이 아니라 답했다는 사실이다.
  selfReportedAt   DateTime?
  reuseGroupId     String? // opaque 토큰만(평문·비번해시 저장 금지). MVP 기본 미사용
  breached         Boolean   @default(false) // 유출 캐시 신호(Breach 관계에서 동기화)

  discovered     Boolean   @default(false) // 사용자가 몰랐던 계정
  // 발견 계정을 사용자가 확인한 시각. null = 아직 확인 안 함.
  //   투명설계안 v2의 S축 "미인지 · 미조치" 인자(p=0.03)는 **모르고 있다는 사실 자체**가 위험이라
  //   감점한다. 그런데 스캔이 화면에 보여준 뒤에도 discovered가 내려가지 않아, 이 신호만
  //   "감점과 회복은 같은 곱셈의 양방향"이라는 원칙에서 빠져 있었다. 발견이 주 수집 경로가 되자
  //   (A1) 인벤토리 전체에 붙어 "계정을 많이 찾을수록 감점" — 불변 원칙 "규모 무감점" 위반이 됐다.
  //   확인 시각을 남겨 인자를 해제한다(2026-08-05). 계정 자체의 위험(방치·유출·위생)은 그대로 남는다.
  acknowledgedAt DateTime?
  riskTags       RiskTag[] // 다중 위험 신호 → 신호등 색

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessLogs      AccessLog[]
  cleanupRequests CleanupRequest[]
  breaches        Breach[]

  @@index([userId])
  @@index([userId, breached])
  @@index([userId, lastUsedAt])
  @@index([userId, category])
  @@index([userId, source])
  // 서비스별 보유자 집계의 진입 인덱스.
  // @@unique([userId, serviceId])를 걸지 않는 이유: 한 사람이 같은 서비스에 계정을 둘 이상
  // 가질 수 있다(개인용·업무용). 유니크를 걸면 그중 하나가 조용히 저장되지 않는다.
  @@index([serviceId])
}

/// 서비스 마스터 — 사용자 간 집계·클러스터링의 기준 신원.
///
/// 표기가 비슷하다는 이유로 자동 병합하지 않는다. 문자열 유사도로 합치면 naver.com과
/// navercorp.com, kakao와 kakaopay가 한 서비스가 된다. 카탈로그가 둘을 같은 도메인으로
/// 알 때만 합친다. 미매칭은 미매칭으로 남기고, 사람이 도메인을 부여하는 것이 정규화의
/// 운영 작업이다 — 이 제품에서 오탐은 미발견보다 나쁘다.
model Service {
  id String @id @default(cuid())

  /// 정규화 키. 도메인이 있으면 도메인에서, 없으면 이름에서 만든다.
  slug String @unique

  /// registrableDomain 기준(서브도메인 병합). 매칭 1순위이자 사실상의 신원.
  domain String? @unique

  /// 사람이 읽는 이름. null이면 화면은 도메인을 그대로 쓴다 — 이름을 지어내지 않는다.
  displayName String?
  category    Category @default(unknown)

  /// 표시명을 사람이 확인한 시점. null인 displayName은 추정이므로 화면이 단정하지 않는다.
  verifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]

  @@index([category])
}

model AccessLog {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  timestamp  DateTime
  location   String // "서울, KR" | "미상"
  device     String // "Chrome / Windows"
  suspicious Boolean  @default(false)

  @@index([accountId, timestamp])
}

model CleanupRequest {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  actionType  ActionType
  deepLink    String? // null=경로 미확보(안내만)
  status      CleanupStatus @default(queued)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime? // done 전이 시각(결과 화면 Before/After 타임라인)

  @@index([userId, status])
  @@index([accountId])
}

model Breach {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String? // 매칭된 계정(있으면). 없으면 서비스명만
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  service       String
  breachDate    DateTime // 월 정밀도는 01일로 정규화(시드 로더)
  exposedFields String[] // ["이메일","비밀번호"]
  advice        String
  severity      BreachSeverity
  resolved      Boolean        @default(false)

  @@index([userId, resolved])
  @@index([accountId])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AlertType
  message     String // 대화체 카피
  triggeredAt DateTime
  read        Boolean   @default(false)

  @@index([userId, triggeredAt])
}

model ScoreSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int // 계산 결과 이력(SSOT 아님, 스냅샷)
  coverage     Float // 확인된 계정 비율(정직성 표기)
  coveredCount Int
  axes         Json? // v2 다차원: 4축(E·S·H·T) 값 + measured 플래그. nullable(v1 이력 백필 불요)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// OAuthToken 모델 제거(H3 least-data, Kit 보안리뷰 T2.4).
//  로그인 전용 최소 scope(openid/email/profile) + JWT 세션이라 provider 토큰 영속이 불필요.
//  토큰을 어디에도 저장하지 않는 것이 최선(저장 표면 제거 = 유출 표면 제거).
//  훗날 백그라운드 갱신 등으로 토큰 보관이 실제로 필요해지면, 그때 AES-GCM 실암호화로 별도 도입.
